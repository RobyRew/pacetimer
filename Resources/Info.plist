<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>PeaceTimer</string>
    <key>CFBundleDisplayName</key>
    <string>PeaceTimer</string>
    <key>CFBundleIdentifier</key>
    <string>com.robyrew.peacetimer</string>
    <!-- Substituted by Xcode from the build settings, so CI can stamp a real version
         per build. Hardcoding these means every build reports the same version, and
         Sparkle can then never tell releases apart — it would keep re-offering the
         same update forever. -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>PeaceTimer</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- REQUIRED for an asset-catalog icon to actually show. Without CFBundleIconName
         macOS ignores the compiled AppIcon in Assets.car and draws the generic blank
         app icon — which is exactly what "the icon isn't showing" was. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <!-- Launch as a menu-bar agent (no Dock icon). The in-app toggle can promote
         the app to .regular at runtime to show a Dock icon. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required because the app activates other applications (NSWorkspace). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>PeaceTimer brings your selected AI app to the front and, only with your confirmation, pastes your saved note.</string>

    <key>NSHumanReadableCopyright</key>
    <string>© 2026</string>

    <!-- Sparkle auto-update (see UPDATES.md). Replace SUPublicEDKey with the EdDSA
         public key from Sparkle's `generate_keys`; until then the updater stays
         dormant. The appcast is published to GitHub Pages by CI. -->
    <key>SUFeedURL</key>
    <string>https://robyrew.github.io/pacetimer/appcast.xml</string>
    <!-- PeaceTimer's OWN signing key (Keychain account "PeaceTimer"), separate from
         other apps' keys so a leak is contained to this app. -->
    <key>SUPublicEDKey</key>
    <string>md3JMF+GB9+7tY+7+pxvuo1f1APzC9vPiHy99wyvOWQ=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAutomaticallyUpdate</key>
    <false/>
</dict>
</plist>
