<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>PeaceTimer</string>
    <key>CFBundleDisplayName</key>
    <string>PeaceTimer</string>
    <key>CFBundleIdentifier</key>
    <string>com.robyrew.peacetimer</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>PeaceTimer</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Launch as a menu-bar agent (no Dock icon). The in-app toggle can promote
         the app to .regular at runtime to show a Dock icon. -->
    <key>LSUIElement</key>
    <true/>

    <!-- Required because the app activates other applications (NSWorkspace). -->
    <key>NSAppleEventsUsageDescription</key>
    <string>PeaceTimer brings your selected AI app to the front and, only with your confirmation, pastes your saved note.</string>

    <key>NSHumanReadableCopyright</key>
    <string>© 2026</string>

    <!-- Sparkle auto-update (see UPDATES.md). Replace SUPublicEDKey with the EdDSA
         public key from Sparkle's `generate_keys`; until then the updater stays
         dormant. The appcast is published to GitHub Pages by CI. -->
    <key>SUFeedURL</key>
    <string>https://robyrew.github.io/pacetimer/appcast.xml</string>
    <key>SUPublicEDKey</key>
    <string>REPLACE_WITH_YOUR_SPARKLE_ED_PUBLIC_KEY</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAutomaticallyUpdate</key>
    <false/>
</dict>
</plist>
